+-- OpenXR owns the current update's clock and focus state. Keep a prepared
+-- frame for draw so the loop waits/locates once, before simulation and input.
+-- Direct draw callers (host render probes) still get a complete frame.
+local vrPrepared
+local function prepareVRFrame()
+  if vrPrepared then return end
+  local width,height = pixelDimensions()
+  local began = VRRuntime.beginFrame(width,height) == true
+  vrPrepared = {width=width,height=height,began=began}
+  if VRRuntime.isBridgeActive() and not vrVsyncDisabled
+     and love.system and love.system.getOS() == "Linux"
+     and love.window and love.window.setVSync then
+    local ok = pcall(love.window.setVSync, 0)
+    if ok then vrVsyncDisabled = true end
+  end
+end
