+local vrSuspended = false
+local vrPausedAudio = nil
+local vrVsyncDisabled = false
+
+local function vrInputAllowed()
+  return not VRRuntime.isBridgeActive() or VRRuntime.shouldSimulate()
+end
+
+local function updateVRActivity()
+  if not VRRuntime.isBridgeActive() then return true end
+  if VRRuntime.isQuitRequested() then
+    love.event.quit()
+    return false
+  end
+  if not VRRuntime.shouldSimulate() then
+    if not vrSuspended then
+      vrSuspended = true
+      if Game and Game.focus then Game:focus(false) end
+      if love.audio then
+        local ok, sources = pcall(love.audio.pause)
+        if ok and type(sources) == "table" then vrPausedAudio = sources end
+      end
+    end
+    return false
+  end
+  if vrSuspended then
+    vrSuspended = false
+    if Game and Game.focus then Game:focus(true) end
+    if love.audio and type(vrPausedAudio) == "table" and #vrPausedAudio > 0 then
+      pcall(love.audio.play, vrPausedAudio)
+    end
+    vrPausedAudio = nil
+  end
+  return true
+end
+
+local vrImporterHeld = {}
+local vrImporterMoveX, vrImporterMoveY = 0, 0
+
+local function resetVRImporterInput()
+  if Importer then
+    for button, held in pairs(vrImporterHeld) do
+      if held and type(Importer.gamepadreleased) == "function" then
+        pcall(Importer.gamepadreleased, Importer, nil, button)
+      end
+    end
+    if type(Importer.gamepadaxis) == "function" then
+      if vrImporterMoveX ~= 0 then
+        pcall(Importer.gamepadaxis, Importer, nil, "leftx", 0)
+      end
+      if vrImporterMoveY ~= 0 then
+        pcall(Importer.gamepadaxis, Importer, nil, "lefty", 0)
+      end
+    end
+  end
+  vrImporterHeld = {}
+  vrImporterMoveX, vrImporterMoveY = 0, 0
+end
+
+local function updateVRImporterInput()
+  if not Importer then
+    resetVRImporterInput()
+    return
+  end
+  if not VRRuntime.isBridgeActive() then return end
+  if not VRRuntime.shouldSimulate() then
+    resetVRImporterInput()
+    return
+  end
+
+  local actions = VRRuntime.pollActions()
+  local buttons = {
+    a = actions.a == true,
+    b = actions.b == true,
+    start = actions.start == true,
+    back = actions.select == true,
+  }
+  for button, down in pairs(buttons) do
+    if down and not vrImporterHeld[button] then
+      if type(Importer.gamepadpressed) == "function" then
+        pcall(Importer.gamepadpressed, Importer, nil, button)
+      end
+    elseif not down and vrImporterHeld[button] then
+      if type(Importer.gamepadreleased) == "function" then
+        pcall(Importer.gamepadreleased, Importer, nil, button)
+      end
+    end
+    vrImporterHeld[button] = down
+  end
+
+  local move = type(actions.move) == "table" and actions.move or {}
+  local moveX = tonumber(move.x) or 0
+  -- OpenXR's stick Y is positive up; LÖVE's gamepad axis is positive down.
+  local moveY = -(tonumber(move.y) or 0)
+  if type(Importer.gamepadaxis) == "function" then
+    if moveX ~= vrImporterMoveX then
+      pcall(Importer.gamepadaxis, Importer, nil, "leftx", moveX)
+      vrImporterMoveX = moveX
+    end
+    if moveY ~= vrImporterMoveY then
+      pcall(Importer.gamepadaxis, Importer, nil, "lefty", moveY)
+      vrImporterMoveY = moveY
+    end
+  end
+end
