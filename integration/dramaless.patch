--- a/lib/Mat4.lua
+++ b/lib/Mat4.lua
@@ -156,0 +157,9 @@
+-- Native XR lens angles, retaining this module's row-major GL convention.
+function Mat4.perspectiveOffAxis(left, right, up, down, near, far)
+  local l, r, t, b = math.tan(left), math.tan(right), math.tan(up), math.tan(down)
+  return { 2/(r-l), 0, (r+l)/(r-l), 0,
+           0, 2/(t-b), (t+b)/(t-b), 0,
+           0, 0, (far+near)/(near-far), 2*far*near/(near-far),
+           0, 0, -1, 0 }
+end
+
